# Settings for `docker compose`. Copy to `.env` and fill in what you need.
# For running without Docker, use backend/.env and frontend/.env.local instead.

STORE_NAME=Nafis
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=nafis

# Creates the owner account on first start (leave the password empty to skip).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ANTHROPIC_API_KEY=
