# Copy this file to `.env` and fill in the values you need.
# Everything except the Django settings is optional: the store runs without them.

# --- Django ---
DJANGO_DEBUG=True
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave empty to use SQLite (db.sqlite3). Example for PostgreSQL:
# DATABASE_URL=postgres://nafis:nafis@localhost:5432/nafis
DATABASE_URL=

STORE_NAME=Nafis

# Encrypts firm owners' passport numbers. Leave empty in development (derived from the secret key);
# set a fixed one in production:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000

# --- Stripe (optional, test mode) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8000/api/payments/stripe/webhook/`
STRIPE_WEBHOOK_SECRET=

# --- Telegram order notifications (optional) ---
# Create a bot with @BotFather, then send it a message and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- AI shopping assistant (optional) ---
# Without a key the assistant uses keyword search over the catalog.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
